{
  "additionalProperties": false,
  "properties": {
    "brand_fit": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer",
    },
    "generic_template_feel": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer",
    },
    "hierarchy": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer",
    },
    "mobile_quality": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer",
    },
    "needs_renderer_change": {
      "type": "boolean",
    },
    "problems": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "area": {
            "enum": [
              "hero",
              "typography",
              "palette",
              "layout",
              "spacing",
              "mobile",
              "motif",
              "information",
              "footer",
              "other",
            ],
            "type": "string",
          },
          "note": {
