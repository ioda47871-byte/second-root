  "note": "Claude が描いた画像 (カンプ、実装 a・b) を PC 1440 と SP 390 で自分で見て、失われたものを出所ごとに分けた。品質の判定ではない。採るかはオーナーが決める。",
  "sources": {
    "comp_quality": "カンプそのものの見落とし。実装の前から在る",
    "placeholder_photo": "写真が役割と大きさだけの単色の仮の板であること。実際の写真は別の承認が要る",
    "impl_rule_limit": "実装レーンの規則 (comp-impl の CSS と HTML の許可一覧) で作れないこと。規則は変えていない",
    "impl_mistake": "規則の中で作れたのに、Claude の実装が落としたこと"
  },
  "rule_probes": {
    "IMPL_RULE_NO_FREE_SHAPE": {
      "html": [
        "<svg viewBox=\"0 0 10 10\"></svg>"
      ],
      "css": [
        "clip-path: polygon(0 0, 100% 0, 50% 100%)"
      ]
    },
    "IMPL_RULE_NO_OVERLAP": {
      "css": [
        "position: absolute",
        "margin-top: -40px",
        "z-index: 2"
      ]
    },
    "IMPL_RULE_NO_TILT_SHADOW": {
      "css": [
        "transform: rotate(2deg)",
        "box-shadow: 0 30px 50px rgba(0, 0, 0, 0.5)",
        "filter: drop-shadow(0 10px 10px #000)"
      ]
    },
    "IMPL_RULE_NO_OUTLINE_TYPE": {
      "css": [
        "-webkit-text-stroke: 1px #b88a35"
      ]
    },
    "IMPL_RULE_NO_VERTICAL_TEXT": {
      "css": [
        "writing-mode: vertical-rl"
      ]
    },
    "IMPL_RULE_TYPE_MAX_256": {
      "css": [
        "font-size: 400px"
      ]
    },
    "IMPL_RULE_NO_GRADIENT_PATTERN": {
      "css": [
        "background: linear-gradient(#000, #fff)",
        "background-image: repeating-linear-gradient(90deg, #000 0 1px, transparent 1px 20px)"
      ]
    },
    "IMPL_RULE_NO_ORDER": {
      "css": [
        "order: 2"
      ]
    }
  },
