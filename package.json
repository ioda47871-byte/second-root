{
  "name": "second-root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/with-supabase-env.mjs playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:integration": "node scripts/with-supabase-env.mjs vitest run -c vitest.integration.config.mts",
    "test:e2e:site": "playwright test tests/e2e/existing-site.spec.ts",
    "staging:apply": "NODE_USE_ENV_PROXY=1 node scripts/staging/apply.mjs",
    "staging:verify": "NODE_USE_ENV_PROXY=1 node scripts/staging/verify.mjs",
    "staging:admin": "NODE_USE_ENV_PROXY=1 node scripts/staging/admin.mjs",
    "staging:vercel": "NODE_USE_ENV_PROXY=1 node scripts/staging/vercel-preview.mjs",
    "sales:design-demo": "tsx scripts/sales-design/design-demo.ts",
    "sales:design-worker": "tsx scripts/sales-design-worker/worker.ts",
    "sales:design-browser": "tsx scripts/sales-design-browser/browser.ts",
    "sales:design-capture": "tsx scripts/sales-design-capture/request.ts",
    "sales:design-assets": "tsx scripts/sales-design-assets/assets.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "~4.0.18"
  }
}
