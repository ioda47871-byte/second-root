# Resend (https://resend.com) API key used to send contact-form submissions.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where inquiries should be delivered.
CONTACT_TO_EMAIL=you@example.com

# Sender address. Must be a verified domain in Resend once you move off the
# resend.dev sandbox sender (onboarding@resend.dev only works while
# CONTACT_TO_EMAIL is the same address used to sign up for Resend).
CONTACT_FROM_EMAIL=Second Root <onboarding@resend.dev>
