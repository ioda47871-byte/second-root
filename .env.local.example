# Resend (https://resend.com) API key used to send contact-form submissions.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where inquiries should be delivered.
CONTACT_TO_EMAIL=you@example.com

# Sender address. secondroot.jp is verified in Resend (SPF/DKIM/DMARC),
# so this can deliver to any recipient, not just the Resend account owner
# (that account-owner-only restriction only applies to the onboarding@
# resend.dev sandbox sender).
CONTACT_FROM_EMAIL=Second Root <info@secondroot.jp>

# All optional — each block only renders once its value is set, so an
# unset var never shows a broken/empty link.
#
# Contact is handled by the form (email) only. Instagram DMs are the first
# sales touchpoint and meetings happen over Google Meet or in person, so
# there is no LINE channel.

# Second Root's own Instagram profile. Until this is set the footer link
# and its instagram_click event stay hidden.
NEXT_PUBLIC_INSTAGRAM_URL=

# Brot Yanagi's site, if and when a public URL can be confirmed. Until then
# the "サイトを見る" button in Works stays hidden.
NEXT_PUBLIC_BROT_YANAGI_URL=
